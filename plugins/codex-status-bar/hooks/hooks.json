{
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume|clear",
      "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/lifecycle.js\" start", "timeout": 10 }]
    }],
    "UserPromptSubmit": [{
      "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/update.js\" prompt", "timeout": 10 }]
    }],
    "PreToolUse": [{
      "matcher": "*",
      "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/update.js\" pre", "timeout": 10 }]
    }],
    "PostToolUse": [{
      "matcher": "*",
      "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/update.js\" post", "timeout": 10 }]
    }],
    "PermissionRequest": [{
      "matcher": "*",
      "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/update.js\" permission", "timeout": 10 }]
    }],
    "SubagentStart": [{
      "matcher": "*",
      "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/update.js\" agent-start", "timeout": 10 }]
    }],
    "SubagentStop": [{
      "matcher": "*",
      "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/update.js\" agent-stop", "timeout": 10 }]
    }],
    "Stop": [{
      "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/update.js\" stop", "timeout": 10 }]
    }]
  }
}
